# ── Database ──────────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=agriagent
DATABASE_NAME=agriagent_db
DEBUG=true

# ── Google Cloud ──────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# ── External API Keys ────────────────────────────────────────────
# Agromonitoring (satellite): https://agromonitoring.com/dashboard
AGROMONITORING_API_KEY=your_key_here

# API Ninjas (commodity prices): https://api-ninjas.com
API_NINJAS_KEY=your_key_here

# CollectAPI (optional): https://collectapi.com
COLLECTAPI_KEY=your_key_here

# ── Notes ─────────────────────────────────────────────────────────
# Open-Meteo: No API key required (free)
# EPPO / GBIF: No API key required (free)
# Google Gemini / Vertex AI: Uses Application Default Credentials (ADC)
